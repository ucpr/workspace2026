# This stack exports traces via OTLP to the bundled Jaeger — no env file is
# required to run it. These are optional overrides if you want to point the
# services at a different OTLP collector or backend.
#
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://your-collector:4318/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=authorization=Bearer <token>
# DD_TRACE_PROPAGATION_STYLE=tracecontext
